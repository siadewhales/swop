{
  "name": "swop",
  "version": "2.1.1",
  "description": "SWOP, Siade Whales Operations Platform portable multi-network desktop app.",
  "type": "module",
  "main": "electron/main.cjs",
  "author": "Siade Whales Company",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev-renderer.mjs",
    "electron:dev": "cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "build:renderer": "node scripts/build-renderer.mjs",
    "build": "npm run build:renderer",
    "dist": "npm run build && electron-builder --win portable",
    "release:portable": "npm run dist",
    "release:linux": "npm run build && electron-builder --linux AppImage"
  },
  "dependencies": {
    "@noble/curves": "1.2.0",
    "@noble/hashes": "1.3.2",
    "@reown/walletkit": "1.5.6",
    "@walletconnect/core": "2.23.10",
    "@walletconnect/utils": "2.23.10",
    "ethers": "6.17.0",
    "i18next": "24.2.3",
    "lucide-react": "^0.468.0",
    "qrcode": "^1.5.4",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-i18next": "15.7.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "cross-env": "^7.0.3",
    "electron": "44.3.0",
    "electron-builder": "^26.15.3",
    "vite": "^6.0.7"
  },
  "build": {
    "appId": "com.siadewhales.whalesoperations",
    "productName": "SWOP",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.ico",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "signExecutable": false,
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "SWOP-${version}-portable.${ext}"
    },
    "portable": {
      "artifactName": "SWOP-${version}-portable.${ext}"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Utility",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "SWOP-${version}-linux-x64.${ext}"
    }
  }
}
